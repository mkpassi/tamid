# FVM Version Cache
.fvm/

# codegen
# NOTE: drift_schemas/ and test/generated_migrations/ look generated but are
# deliberately TRACKED. The snapshots are the only record of what each past
# schema version looked like; lose them and no future migration can be tested
# against real historical data. Do not add them here.
*.g.dart
*.drift.dart
*.freezed.dart

# fvm
.fvm/flutter_sdk
.fvm/versions

# Gradle build output
/android/build/
/android/.gradle/

# DevTools
devtools_options.yaml
